# Copy to .env.local. Every value has a safe default, so the site also runs with none of them set.

# Public site URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.bestdoctorsin.com

# "off" (default): every page is noindex, robots.txt disallows all, sitemap is empty.
# "on": each page is indexable only if it is published AND passes the publish gate (G1-G13).
NEXT_PUBLIC_INDEXING=off

# "all" (default while indexing is off): menus and footer link to every built page.
# "live": menus and footer link only to published pages that pass the gate.
NEXT_PUBLIC_LINK_MODE=all

# "on" (default) shows the prototype banner. Set to "off" at launch.
NEXT_PUBLIC_PROTOTYPE_BANNER=on

# WhatsApp number with country code, digits only. Placeholder until the real number exists.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Hindi version: hreflang tags are written only when this is "on" (the /hi/ pages are not built yet).
NEXT_PUBLIC_HI_ENABLED=off

# Analytics stub. Off by default. If "on", the script below is added with defer; nothing is
# sent from form fields and no third-party tracker is bundled.
NEXT_PUBLIC_ANALYTICS=off
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Supabase. Leave empty to run on built-in sample data (fixtures).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret for POST /api/revalidate (called by a Supabase webhook or CI when a page is published).
REVALIDATE_SECRET=
